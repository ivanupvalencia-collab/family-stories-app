migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Secrets (S-14): nunca al repo, aunque aparezcan en un commit futuro
.env*
*.jks
*.keystore
key.properties
*.p12
*.pem
*.p8
*.mobileprovision

# The iOS platform folder is versioned: it carries app configuration
# (Info.plist, URL schemes, Google Sign-In, signing). Ephemeral files
# inside are ignored by ios/.gitignore (Pods, symlinks, Generated).
